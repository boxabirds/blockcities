{
  "name": "blockcities",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "vite build",
    "preview": "vite preview",
    "play:build": "vite build --outDir play",
    "play": "vite preview --outDir play --port 5199 --strictPort",
    "sim": "node sim/report.ts",
    "tune": "node sim/tune.ts",
    "weather:budget": "uv run --with playwright scripts/weather-budget.py"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
